// ==================================================
// 1. LOGS COLLECTION & REMOTE PUSH
// ==================================================

discovery.docker "docker_containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.docker_containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_monitor_logs"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }

  rule {
    replacement  = "prod"
    target_label = "environment"
  }

  rule {
    target_label = "host"
    replacement  = "edge-server-1"
  }
}

loki.source.docker "docker_logs" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.docker_logs.output
  forward_to       = [loki.write.remote_loki.receiver]
  refresh_interval = "5s"
}

// Push logs to the gateway service on Monitoring VPS
loki.write "remote_loki" {
  endpoint {
    url       = "http://10.0.2.2:3100/loki/api/v1/push"
    tenant_id = "tenant1"
  }
}

// ==================================================
// 2. METRICS COLLECTION & REMOTE PUSH
// ==================================================

// System metrics (built-in Node Exporter)
prometheus.exporter.unix "node" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"
}

prometheus.scrape "node_metrics" {
  targets         = prometheus.exporter.unix.node.targets
  forward_to      = [prometheus.remote_write.remote_prometheus.receiver]
  scrape_interval = "15s"
}

// Container metrics (cAdvisor)
prometheus.exporter.cadvisor "docker" {
  docker_host      = "unix:///var/run/docker.sock"
  storage_duration = "5m"
}

prometheus.scrape "docker_metrics" {
  targets         = prometheus.exporter.cadvisor.docker.targets
  forward_to      = [prometheus.remote_write.remote_prometheus.receiver]
  scrape_interval = "15s"
}

// Push metrics directly to Prometheus remote write receiver
prometheus.remote_write "remote_prometheus" {
  endpoint {
    url = "http://10.0.2.2:9090/api/v1/write"
  }

  // FIXED: Standard Grafana dashboards require "instance" and "job" labels
  external_labels = {
    environment = "prod",
    instance    = "edge-server-1",
    job         = "node-exporter",
  }
}